{
  "name": "dsh-plugin-reverse-proxy",
  "version": "0.5.1",
  "description": "DSH Web 局域网访问插件：内置反向代理 + 免 Token 登录，手机/平板同 Wi-Fi 直接打开后台；端口可自定义，支持访问 IP 黑名单与一键重置。默认只监听本机，需显式开启。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./vendor/skip/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lan-access.js",
    "README.md",
    "README.en.md",
    "assets",
    "vendor",
    "LICENSE",
    "CHANGELOG.md",
    "screenshots.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "reverse-proxy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "author": {
    "name": "云风",
    "email": "3538638569@qq.com",
    "url": "https://github.com/llifco"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llifco/dsh-plugin-reverse-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/llifco/dsh-plugin-reverse-proxy/issues"
  },
  "homepage": "https://github.com/llifco/dsh-plugin-reverse-proxy#readme"
}
