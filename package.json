{
  "name": "dsh-plugin-reverse-proxy",
  "version": "0.3.0",
  "description": "DSH Web 反向代理 + 免 Token 登录（Web UI 专用）：监听局域网端口，改写 Host/Origin/Sec-Fetch-Site 后转发到 127.0.0.1:3080，并替换官方 Connection 提供方跳过 BrowserAuth（版本门控，不匹配自动休眠）。仅适用于 Web UI 版，桌面版用不上。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./vendor/skip/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "vendor",
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "reverse-proxy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "author": {
    "name": "云风",
    "email": "3538638569@qq.com",
    "url": "https://github.com/llifco"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llifco/dsh-plugin-reverse-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/llifco/dsh-plugin-reverse-proxy/issues"
  },
  "homepage": "https://github.com/llifco/dsh-plugin-reverse-proxy#readme"
}
